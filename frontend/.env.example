# Data source ------------------------------------------------------------
# "mock" (default) serves the deterministic demo scenario from src/data.
# "live" switches every screen onto the REST adapter in src/services/httpDataSource.ts.
NEXT_PUBLIC_API_MODE=mock

# Base URL of the Python backend. Required when NEXT_PUBLIC_API_MODE=live.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Optional WebSocket endpoint. When set (and mode is live), realtime updates
# arrive over the socket instead of polling.
# NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/stream

# Polling fallback interval, milliseconds.
NEXT_PUBLIC_POLL_INTERVAL_MS=5000

# Artificial latency for the mock adapter so loading states stay visible.
NEXT_PUBLIC_MOCK_LATENCY_MS=260

# Gate the control centre behind sign-in. Left false so demonstrations open
# straight into the dashboard; set true once a real identity provider is wired
# to the /auth endpoints.
NEXT_PUBLIC_REQUIRE_AUTH=false
